# ---- Brno Cycle Explorer configuration (copy to .env) ----
# API
API_PORT=3001
LOG_LEVEL=info
# Directory for the cached infrastructure dataset (relative to the API working dir or absolute)
CACHE_DIR=./data-cache
# Official Brno ArcGIS FeatureServer layer (polyline, supports GeoJSON)
ARCGIS_LAYER_URL=https://services6.arcgis.com/fUWVlHWZNxUvTUh8/ArcGIS/rest/services/cykloopatreni_realizovana_opendata/FeatureServer/0
ARCGIS_TIMEOUT_MS=30000
ARCGIS_BATCH_SIZE=500
DATA_REFRESH_INTERVAL_HOURS=24
DATA_REFRESH_ON_START_HOURS=24

# Routing engines, in order of preference (the first is the default in the planner).
# Set ROUTING_PROVIDER=none to turn automatic routing off.
ROUTING_ENGINES=brouter,valhalla
# Public BRouter server (no SLA, limited capacity; the app spaces its requests ~1 s apart).
# For heavier use, run your own BRouter with the Czech segment files and point this at it.
BROUTER_URL=https://brouter.de
# Public FOSSGIS Valhalla instance (fair use, no SLA). For heavy use run your own (see README).
VALHALLA_URL=https://valhalla1.openstreetmap.de
ROUTING_TIMEOUT_MS=30000

# Geocoding (Nominatim usage policy: max 1 req/s, identifying User-Agent)
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=BrnoCycleExplorer/1.0 (self-hosted open-source app)

# Basemap styles (JSON array). Default: OpenFreeMap Liberty / Positron / Dark (no key needed).
# Example for MapTiler (needs your own key):
# BASEMAP_STYLES=[{"id":"maptiler","label":"MapTiler Streets","url":"https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY","dark":false}]
# DEFAULT_BASEMAP=ofm-liberty

# CORS for the API (empty = allow all; set to your frontend origin in production)
CORS_ORIGIN=

# Frontend dev server
WEB_PORT=5173
# Where the Vite dev server proxies /api to
VITE_API_PROXY_TARGET=http://localhost:3001
